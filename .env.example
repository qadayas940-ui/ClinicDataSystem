# نموذج ملف البيئة — انسخه إلى .env وعدّل القيم
SECRET_KEY=ضع-مفتاحاً-سرياً-قوياً-هنا
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CLINIC_DATA_PATH=
FACILITY_NAME=عيادة الموصل الخيرية
DATABASE_URL=postgresql://clinic_user:CHANGE_ME@127.0.0.1:5432/clinic_data
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60
CSRF_TRUSTED_ORIGINS=https://clinic.example.org
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10
